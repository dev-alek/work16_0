ADD FIELD "promo-id" OF "c-chk-discnt" AS character
  DESCRIPTION "Код промоакции"
  FORMAT "x(8)"
  POSITION 33
  INITIAL ""
  LABEL "Промоакция"
  COLUMN-LABEL "Промоакция"
  ORDER 550
  MAX-WIDTH 16

ADD FIELD "obj-list" OF "c-contract" AS character
  DESCRIPTION "Список объектов, для которых доступен договор"
  FORMAT "x(8)"
  POSITION 144
  INITIAL ""
  LABEL "Объекты"
  COLUMN-LABEL "Объекты"
  ORDER 1460
  MAX-WIDTH 16

ADD FIELD "obj-type" OF "c-contract-specif" AS character
  DESCRIPTION "Перечислимый тип объекта учета товара: склад, магазин`Obj`Obiect"
  FORMAT "x(3)"
  POSITION 39
  INITIAL ""
  LABEL "Объект"
  COLUMN-LABEL "Объект"
  ORDER 370
  MAX-WIDTH 6

ADD FIELD "obj-code" OF "c-contract-specif" AS integer
  DESCRIPTION "Код объекта - уникальный внутри конкретного справочника`Code`Cod"
  FORMAT "99999"
  POSITION 40
  INITIAL "0"
  LABEL "Код"
  COLUMN-LABEL "Код"
  ORDER 380
  MAX-WIDTH 4

ADD FIELD "date-from" OF "c-contract-specif" AS date
  DESCRIPTION "Дата начала действия цены"
  FORMAT "99/99/99"
  POSITION 41
  INITIAL ?
  LABEL "Дата с"
  COLUMN-LABEL "Дата с"
  ORDER 390
  MAX-WIDTH 4

ADD FIELD "date-to" OF "c-contract-specif" AS date
