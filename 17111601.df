  MAX-WIDTH 16

ADD FIELD "promo-id" OF "c-dis-rule" AS character
  DESCRIPTION "Код промоакции"
  FORMAT "x(8)"
  POSITION 43
  INITIAL ""
  LABEL "Промоакция"
  COLUMN-LABEL "Промоакция"
  ORDER 360
  MAX-WIDTH 16

ADD INDEX "promo" ON "c-dis-rule"
  AREA "History"
  DESCRIPTION "Для поиска правил по номеру промоакции"
  INDEX-FIELD "promo-id" ASCENDING

